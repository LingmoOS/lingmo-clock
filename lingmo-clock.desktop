[Desktop Entry]
Version=1.0
Name=Clock
Name[zh_CN]=时钟
Comment=A clock, world clock, stopwatch and timer
Comment[zh_CN]=时钟、世界时钟、秒表和计时器
Exec=lingmo-clock
Icon=lingmo-clock
Terminal=false
Type=Application
Categories=Utility;Clock;
Keywords=Clock;Time;Timer;Stopwatch;World;Alarm;
Keywords[zh_CN]=时钟;时间;计时器;秒表;世界;闹钟;
StartupNotify=true
